# =============================================================================
# Real-Time Agent Collaboration — VPS environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# Loaded by docker-compose into the openclaw + setup-ui containers.
# =============================================================================

# --- Public hostname / TLS (Caddy) -------------------------------------------
# The domain (or subdomain) whose DNS A record points at this VPS.
DOMAIN=claw.asabizanjo.dev
# Email for Let's Encrypt expiry/renewal notices.
ACME_EMAIL=asa.bizanjo.25@ucl.ac.uk

# --- OpenClaw gateway --------------------------------------------------------
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan
# Admin token for the Control UI. Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=/home/node/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
PORT=18789
# Shared secret protecting the /hooks endpoint. Generate: openssl rand -hex 32
OPENCLAW_WEBHOOK_SECRET=
# Enables the documented loopback-only browser-control service used by
# meeting-join. It is authenticated with OPENCLAW_GATEWAY_TOKEN.
OPENCLAW_EAGER_BROWSER_CONTROL_SERVER=1

# Allowed browser origin for the Control UI — must be the public https URL.
CONTROL_UI_ORIGIN=https://claw.asabizanjo.dev

# --- LLM provider (Cisco proxy) ----------------------------------------------
CISCO_LLM_API_KEY=

# --- Webex channel -----------------------------------------------------------
WEBEX_BOT_TOKEN=
WEBEX_ACCESS_TOKEN=
WEBEX_REFRESH_TOKEN=
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
# HMAC secret Webex signs webhook payloads with. Generate: openssl rand -hex 32
WEBEX_WEBHOOK_SECRET=
# Public URL Webex POSTs inbound messages to — must be your domain + this path.
WEBEX_WEBHOOK_URL=https://claw.asabizanjo.dev/webhooks/webex/default

# --- Dedicated Webex meeting attendee (meeting-join) -------------------------
# These belong to the licensed human Webex account that joins meetings. Keep
# them separate from the bot and channel OAuth identities above.
MEETING_JOIN_CLIENT_ID=C4953027fca0ae6a1dd8081b8e75370dddc8271efb2655f9541381c04f62172af
MEETING_JOIN_CLIENT_SECRET=d1329812e54e3fdb0ae65387da8ccece6380cb3cde410ee5913f3de0bae0cd96
MEETING_JOIN_REFRESH_TOKEN=
# Optional bootstrap token; the plugin immediately refreshes using the token above.
MEETING_JOIN_ACCESS_TOKEN=
MEETING_JOIN_EXPECTED_EMAIL=asabizanjo@gmail.com
# Base64-encoded 32-byte key. Generate with:
# openssl rand -base64 32
MEETING_JOIN_ENCRYPTION_KEY=wkWfFI6wV7mhrT3UBZSj2jlRW/QqpFuWTPEzob4LtEo=

# --- GitHub App (setup-ui + agent tooling) -----------------------------------
GITHUB_APP_ID=
GITHUB_APP_NAME=
# The private key is mounted from secrets/github-app-private-key.pem and read
# from this path. Leave GITHUB_APP_PRIVATE_KEY unset when using the file.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key.pem
# Alternative: paste the PEM inline with \n escapes instead of using a file.
# GITHUB_APP_PRIVATE_KEY=

# --- Deployment agent (hosting VPS) ------------------------------------------
# The separate VPS that hosts deployed apps. Provision it with
# scripts/bootstrap-target-vps.sh, which prints the DEPLOY_DOMAIN_SUFFIX to use.
# The plugin reaches it over SSH using a key locked to a forced command
# (deploy-cli only). Generate the keypair, run bootstrap with the PUBLIC key,
# and mount the PRIVATE key at secrets/deploy-vps-key (chmod 600).
DEPLOY_VPS_HOST=13.63.129.243
DEPLOY_DOMAIN_SUFFIX=13-63-129-243.sslip.io
DEPLOY_VPS_USER=deploy
DEPLOY_VPS_PORT=22
DEPLOY_VPS_KEY=/run/secrets/deploy-vps-key
# App URL suffix: <app-name>.<suffix>. For sslip.io use <ip-with-dashes>.sslip.io
# (e.g. 203-0-113-1.sslip.io). Must match what bootstrap configured on the VPS.
DEPLOY_DOMAIN_SUFFIX=

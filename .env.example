# =============================================================================
# Real-Time Agent Collaboration — VPS environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# Loaded by docker-compose into the openclaw + setup-ui containers.
# =============================================================================

# --- Public hostname / TLS (Caddy) -------------------------------------------
# The domain (or subdomain) whose DNS A record points at this VPS.
DOMAIN=claw.asabizanjo.dev
# Email for Let's Encrypt expiry/renewal notices.
ACME_EMAIL=asa.bizanjo.25@ucl.ac.uk

# --- OpenClaw gateway --------------------------------------------------------
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_BIND=lan
# Admin token for the Control UI. Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_STATE_DIR=/home/node/.openclaw
OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace
PORT=18789
# Shared secret protecting the /hooks endpoint. Generate: openssl rand -hex 32
OPENCLAW_WEBHOOK_SECRET=

# Allowed browser origin for the Control UI — must be the public https URL.
CONTROL_UI_ORIGIN=https://claw.asabizanjo.dev

# --- LLM provider (Cisco proxy) ----------------------------------------------
CISCO_LLM_API_KEY=

# --- Webex channel -----------------------------------------------------------
WEBEX_BOT_TOKEN=
WEBEX_ACCESS_TOKEN=
WEBEX_REFRESH_TOKEN=
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
# HMAC secret Webex signs webhook payloads with. Generate: openssl rand -hex 32
WEBEX_WEBHOOK_SECRET=
# Public URLs Webex POSTs inbound events to — must be your domain + these
# paths. Registration is split by token identity: attachment actions arrive on
# the bot webhook, space messages on the oauth webhook.
WEBEX_BOT_WEBHOOK_URL=https://claw.asabizanjo.dev/webhooks/webex/bot/default
WEBEX_OAUTH_WEBHOOK_URL=https://claw.asabizanjo.dev/webhooks/webex/oauth/default

# --- Webex meeting auto-join plugin (plugins/webex-meeting-join) ------------
# Self-contained plugin: joins Webex space meetings via the Browser SDK when
# they start, and leaves on chat command ("leave meeting"). Uses the same
# dedicated human-user Webex account as above (bot accounts cannot join
# meetings) — only set WEBEX_MEETING_* below if that account ever needs to
# differ from WEBEX_ACCESS_TOKEN/WEBEX_REFRESH_TOKEN/WEBEX_CLIENT_ID/
# WEBEX_CLIENT_SECRET.
# WEBEX_MEETING_ACCESS_TOKEN=
# WEBEX_MEETING_REFRESH_TOKEN=
# WEBEX_MEETING_CLIENT_ID=
# WEBEX_MEETING_CLIENT_SECRET=
# The meeting-account OAuth grant also needs meeting:transcripts_read and
# meeting:schedules_read for post-meeting minutes. Reauthorize after adding
# scopes; refreshing an older grant does not add them.
# Public base URL for this plugin's own webhook route (distinct from the
# WEBEX_*_WEBHOOK_URL pair above, which belongs to the main webex plugin).
WEBEX_MEETING_WEBHOOK_URL=https://claw.asabizanjo.dev/webhooks/webex-meeting-join
# Live-transcription source: webex, deepgram, or off. Defaults to webex.
WEBEX_MEETING_TRANSCRIPTION_PROVIDER=webex
# Optional tuning — sane defaults apply if left unset.
# WEBEX_MEETING_POLL_INTERVAL_MS=300000
# WEBEX_MEETING_JOIN_TIMEOUT_MS=20000
# Post-meeting minutes: meetingTranscripts/created is primary;
# meetings/ended starts bounded polling recovery for a missed event.
# WEBEX_MEETING_MINUTES_ENABLED=true
# WEBEX_MEETING_TRANSCRIPT_RECOVERY_DELAY_MS=60000
# WEBEX_MEETING_TRANSCRIPT_RECOVERY_MAX_DELAY_MS=300000
# WEBEX_MEETING_TRANSCRIPT_RECOVERY_WINDOW_MS=7200000
# Chunking is disabled by default. Set a positive character limit to enable it.
# WEBEX_MEETING_MINUTES_CHUNK_CHARS=80000
# alternative to GitHub App auth for writing
# .collab/meeting minutes.md in the space's mapped project repository.
# WEBEX_MEETING_MINUTES_GITHUB_TOKEN=

# --- GitHub App (setup-ui + agent tooling) -----------------------------------
GITHUB_APP_ID=
GITHUB_APP_NAME=
# The private key is mounted from secrets/github-app-private-key.pem and read
# from this path. Leave GITHUB_APP_PRIVATE_KEY unset when using the file.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app-private-key.pem
# Alternative: paste the PEM inline with \n escapes instead of using a file.
# GITHUB_APP_PRIVATE_KEY=

{
  "id": "webex",
  "name": "Webex Channel",
  "description": "Cisco Webex messaging integration for OpenClaw",
  "channels": ["webex"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": false
      },
      "token": {
        "type": "string",
        "description": "Webex bot access token"
      },
      "webhookUrl": {
        "type": "string",
        "description": "Public URL for receiving Webex webhook POSTs"
      },
      "webhookSecret": {
        "type": "string",
        "description": "HMAC-SHA1 secret for verifying webhook signatures"
      },
      "dmPolicy": {
        "type": "string",
        "enum": ["allow", "deny", "allowlisted"],
        "default": "deny",
        "description": "Policy for direct messages"
      },
      "allowFrom": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Allowed sender emails or person IDs (dmPolicy: allowlisted)"
      }
    },
    "required": ["token", "webhookUrl"]
  }
}

{
  "name": "@openclaw/webex",
  "version": "1.0.0",
  "description": "Webex channel plugin for OpenClaw",
  "main": "index.js",
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "channel": {
      "id": "webex",
      "label": "Webex",
      "selectionLabel": "Cisco Webex",
      "docsPath": "/channels/webex",
      "blurb": "Cisco Webex messaging via bot webhooks.",
      "aliases": [
        "cisco-webex"
      ]
    }
  },
  "dependencies": {
    "playwright": "^1.61.1",
    "esbuild": "^0.24.0",
    "webex": "^3.12.0"
  },
  "scripts": {
    "build:meeting-client": "esbuild client.js --bundle --outfile=meeting-client.bundle.js && node copy-webex-sdk.js"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
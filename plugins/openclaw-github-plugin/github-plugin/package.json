{
  "name": "github-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "GitHub plugin for OpenClaw using GitHub App authentication",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run tests/issues.integration.test.ts",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "openclaw plugins validate --entry ./dist/index.js"
  },
  "dependencies": {
    "@octokit/request": "^9.0.0",
    "jsonwebtoken": "^9.0.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}

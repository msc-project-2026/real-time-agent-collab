{
  "id": "deploy-agent",
  "name": "Deployment Agent",
  "description": "Registers deploy-cli tools and deployment orchestration channels. The main agent hands deployments to a cheap deployer agent; failures escalate to an expensive debugger agent.",
  "channels": ["deploy", "deploy-debug"],
  "contracts": {
    "tools": [
      "deploy_app",
      "redeploy_app",
      "list_apps",
      "app_status",
      "app_logs",
      "stop_app",
      "start_app",
      "remove_app",
      "app_url",
      "host_resources",
      "request_deployment",
      "escalate_debug"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      }
    }
  }
}

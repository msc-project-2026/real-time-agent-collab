{
  "gateway": {
    "mode": "local",
    "controlUi": {
      "allowedOrigins": [
        "https://real-time-agent-collab-production.up.railway.app"
      ],
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "trustedProxies": [
      "100.64.0.3",
      "100.64.0.5",
      "100.64.0.6",
      "100.64.0.7",
      "100.64.0.8",
      "100.64.0.11"
    ]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cisco": {
        "baseUrl": "https://llm-proxy.dev.outshift.ai/",
        "apiKey": "${CISCO_LLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "bedrock/global.anthropic.claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "compat": { "supportsUsageInStreaming": true }
          },
          {
            "id": "bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
            "name": "Claude Haiku 4.5",
            "compat": { "supportsUsageInStreaming": true }
          },
          {
            "id": "azure/gpt-5.4",
            "name": "GPT-5.4",
            "compat": { "supportsUsageInStreaming": true }
          },
          {
            "id": "vertex_ai/gemini-3-pro-preview",
            "name": "Gemini 3 Pro Preview",
            "compat": { "supportsUsageInStreaming": true }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "cisco/bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
      },
      "memorySearch": {
        "provider": "none"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "memorySearch": {
          "provider": "openai",
          "model": "azure/text-embedding-3-small",
          "remote": {
            "baseUrl": "https://llm-proxy.dev.outshift.ai/",
            "apiKey": "${CISCO_LLM_API_KEY}"
          }
        }
      },
      {
        "id": "collab-agent",
        "agentDir": "plugins/webex/agent-identity",
        "contextInjection": "never",
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "submit_gate_decision",
            "write_task",
            "search_tasks",
            "write_summary",
            "search_recall",
            "message"
          ]
        },
        "skills": [],
        "memorySearch": {
          "provider": "openai",
          "model": "azure/text-embedding-3-small",
          "remote": {
            "baseUrl": "https://llm-proxy.dev.outshift.ai/",
            "apiKey": "${CISCO_LLM_API_KEY}"
          }
        }
      }
    ]
  },
  "cron": {
    "enabled": true,
    "maxConcurrentRuns": 8
  },
  "session": {
    "maintenance": {
      "mode": "enforce",
      "maxDiskBytes": 20000000,
      "highWaterBytes": 5000000
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": { "channel": "webex" }
    }
  ],
  "channels": {
    "webex": {
      "enabled": true,
      "token": "${WEBEX_BOT_TOKEN}",
      "accessToken": "${WEBEX_ACCESS_TOKEN}",
      "refreshToken": "${WEBEX_REFRESH_TOKEN}",
      "clientId": "${WEBEX_CLIENT_ID}",
      "clientSecret": "${WEBEX_CLIENT_SECRET}",
      "botWebhookUrl": "https://real-time-agent-collab-production.up.railway.app/webhooks/webex/bot/default",
      "oauthWebhookUrl": "https://real-time-agent-collab-production.up.railway.app/webhooks/webex/oauth/default",
      "webhookSecret": "${WEBEX_WEBHOOK_SECRET}",
      "dmPolicy": "allowlisted",
      "allowFrom": [
        "ucabtg2@ucl.ac.uk",
        "ucab295@ucl.ac.uk",
        "crystal.phua.25@ucl.ac.uk",
        "davit.gevorgyan.25@ucl.ac.uk",
        "leonardo.martin.25@ucl.ac.uk",
        "shuminwang233@outlook.com"
      ]
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_WEBHOOK_SECRET}",
    "path": "/hooks",
    "allowRequestSessionKey": true,
    "allowedSessionKeyPrefixes": ["agent:collab-agent:webex:", "hook:"],
    "defaultSessionKey": "hook:collab-sync"
  },
  "plugins": {
    "allow": ["webex", "memory-core", "openai"],
    "load": {
      "paths": ["plugins/webex"]
    },
    "entries": {
      "webex": {
        "enabled": true,
        "config": {
          "collabAgentId": "collab-agent"
        }
      }
    }
  }
}

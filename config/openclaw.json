{
  "gateway": {
    "mode": "local",
    "controlUi": {
      "allowedOrigins": ["${CONTROL_UI_ORIGIN}"],
      "dangerouslyDisableDeviceAuth": true
    },
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "trustedProxies": ["172.28.0.10"]
  },
  "models": {
    "mode": "merge",
    "providers": {
      "cisco": {
        "baseUrl": "https://llm-proxy.dev.outshift.ai/",
        "apiKey": "${CISCO_LLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "bedrock/global.anthropic.claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6"
          },
          {
            "id": "bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0",
            "name": "Claude Haiku 4.5"
          },
          { "id": "azure/gpt-5.4", "name": "GPT-5.4" },
          {
            "id": "vertex_ai/gemini-3-pro-preview",
            "name": "Gemini 3 Pro Preview"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "cisco/bedrock/global.anthropic.claude-sonnet-4-6"
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "tools": {
          "alsoAllow": ["browser", "join_webex_meeting", "leave_webex_meeting"]
        }
      },
      {
        "id": "observer",
        "model": {
          "primary": "cisco/bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },
      {
        "id": "deployer",
        "model": {
          "primary": "cisco/bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      },
      {
        "id": "deploy-debugger",
        "model": {
          "primary": "cisco/bedrock/global.anthropic.claude-sonnet-4-6"
        }
      }
    ]
  },
  "bindings": [
    {
      "agentId": "main",
      "match": { "channel": "webex" }
    },
    {
      "agentId": "observer",
      "match": { "channel": "source-observer" }
    },
    {
      "agentId": "deployer",
      "match": { "channel": "deploy" }
    },
    {
      "agentId": "deploy-debugger",
      "match": { "channel": "deploy-debug" }
    }
  ],
  "channels": {
    "source-observer": {
      "enabled": true
    },
    "deploy": {
      "enabled": true
    },
    "deploy-debug": {
      "enabled": true
    },
    "webex": {
      "enabled": true,
      "token": "${WEBEX_BOT_TOKEN}",
      "accessToken": "${WEBEX_ACCESS_TOKEN}",
      "refreshToken": "${WEBEX_REFRESH_TOKEN}",
      "clientId": "${WEBEX_CLIENT_ID}",
      "clientSecret": "${WEBEX_CLIENT_SECRET}",
      "webhookUrl": "${WEBEX_WEBHOOK_URL}",
      "webhookSecret": "${WEBEX_WEBHOOK_SECRET}",
      "dmPolicy": "allowlisted",
      "allowFrom": [
        "ucabtg2@ucl.ac.uk",
        "ucab295@ucl.ac.uk",
        "davit.gevorgyan.25@ucl.ac.uk",
        "leonardo.martin.25@ucl.ac.uk"
      ],
      "proactivity": {
        "_comment": "Tune without redeploying — only a container restart is needed. All fields have in-code defaults.",
        "gateThreshold": 0.6,
        "system1Prob": 0.05,
        "lullWindowMs": 8000,
        "lullMaxWaitMs": 30000,
        "silenceGapMs": 14400000,
        "silenceThresholdBonus": 0.15,
        "thresholdByType": {
          "FACTUAL_CORRECTION": 0.4,
          "BLOCKER": 0.45,
          "CLARIFICATION": 0.55,
          "ELABORATION": 0.75,
          "NONE": 1.1
        },
        "gate": {
          "url": "https://llm-proxy.dev.outshift.ai/chat/completions",
          "model": "bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0"
        }
      }
    }
  },
  "hooks": {
    "enabled": true,
    "token": "${OPENCLAW_WEBHOOK_SECRET}",
    "path": "/hooks",
    "allowRequestSessionKey": true,
    "allowedSessionKeyPrefixes": ["agent:main:webex:", "hook:"],
    "defaultSessionKey": "hook:collab-sync"
  },
  "browser": {
    "enabled": true,
    "evaluateEnabled": false,
    "headless": true,
    "noSandbox": true,
    "defaultProfile": "meeting-join",
    "tabCleanup": {
      "enabled": false
    },
    "ssrfPolicy": {
      "allowedHostnames": ["localhost", "127.0.0.1"]
    },
    "profiles": {
      "meeting-join": {
        "cdpPort": 18801,
        "color": "#6D28D9"
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "plugins/meeting-join",
        "plugins/webex",
        "plugins/openclaw",
        "plugins/source-observer",
        "plugins/deploy-agent"
      ]
    },
    "entries": {
      "meeting-join": {
        "enabled": true,
        "config": {
          "maxConcurrentMeetings": 4,
          "browserProfile": "meeting-join",
          "recoveryMaxAttempts": 5,
          "recoveryBaseDelayMs": 1000
        }
      },
      "source-observer": {
        "enabled": true
      },
      "webex": {
        "enabled": true
      },
      "collab-writer": {
        "enabled": true
      },
      "deploy-agent": {
        "enabled": true
      }
    }
  }
}
